<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Spark Cycling</author>
  <name>VO2 Blast</name>
  <description>High intensity 5x3min VO2max intervals</description>
  <sportType>bike</sportType>
  <tags>
  </tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.8">
      <textevent timeoffset="0" message="Warm up well for these hard efforts"/>
    </Warmup>
    <IntervalsT Repeat="5" OnDuration="180" OffDuration="180" OnPower="1.15" OffPower="0.5">
      <textevent timeoffset="0" message="First VO2 interval! Push hard!"/>
      <textevent timeoffset="360" message="2 of 5 - breathe!"/>
      <textevent timeoffset="720" message="Halfway there!"/>
      <textevent timeoffset="1440" message="Final interval - empty the tank!"/>
    </IntervalsT>
    <Cooldown Duration="300" PowerLow="0.6" PowerHigh="0.4">
      <textevent timeoffset="180" message="YES! You crushed 5 VO2 max intervals - your cardiovascular system just got a massive upgrade!"/>
    </Cooldown>
  </workout>
</workout_file>