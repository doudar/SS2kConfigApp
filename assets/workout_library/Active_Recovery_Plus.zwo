<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Spark Cycling</author>
  <name>Active Recovery Plus</name>
  <description>Easy recovery with gentle micro efforts</description>
  <sportType>bike</sportType>
  <tags>
  </tags>
  <workout>
    <SteadyState Duration="900" Power="0.5">
      <textevent timeoffset="0" message="Easy recovery today"/>
    </SteadyState>
    <IntervalsT Repeat="6" OnDuration="60" OffDuration="180" OnPower="0.65" OffPower="0.5">
      <textevent timeoffset="0" message="Gentle efforts to flush legs"/>
    </IntervalsT>
    <SteadyState Duration="600" Power="0.5">
      <textevent timeoffset="60" message="Almost done - stay relaxed"/>
    </SteadyState>
  </workout>
</workout_file>