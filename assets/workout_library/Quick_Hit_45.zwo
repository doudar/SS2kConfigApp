<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Spark Cycling</author>
  <name>Quick Hit 45</name>
  <description>High-intensity 45-minute workout</description>
  <sportType>bike</sportType>
  <tags>
  </tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.8"/>
    <IntervalsT Repeat="3" OnDuration="240" OffDuration="120" OnPower="0.92" OffPower="0.6">
      <textevent timeoffset="0" message="Sweet spot efforts"/>
    </IntervalsT>
    <SteadyState Duration="180" Power="0.55">
      <textevent timeoffset="0" message="Brief rest"/>
    </SteadyState>
    <IntervalsT Repeat="4" OnDuration="90" OffDuration="90" OnPower="1.15" OffPower="0.55">
      <textevent timeoffset="0" message="VO2 max time!"/>
    </IntervalsT>
    <Cooldown Duration="300" PowerLow="0.6" PowerHigh="0.4">
      <textevent timeoffset="0" message="Perfect! 45 minutes of quality - sweet spot AND VO2 - maximum efficiency!"/>
    </Cooldown>
  </workout>
</workout_file>