<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Spark Cycling</author>
  <name>Threshold Builder</name>
  <description>2x20min FTP intervals - the classic</description>
  <sportType>bike</sportType>
  <tags>
  </tags>
  <workout>
    <Warmup Duration="900" PowerLow="0.5" PowerHigh="0.75"/>
    <SteadyState Duration="1200" Power="0.95">
      <textevent timeoffset="0" message="First 20min at FTP - pace yourself!"/>
      <textevent timeoffset="600" message="10min down, 10min to go"/>
    </SteadyState>
    <SteadyState Duration="600" Power="0.55">
      <textevent timeoffset="0" message="Recovery - prepare for round 2"/>
    </SteadyState>
    <SteadyState Duration="1200" Power="0.95">
      <textevent timeoffset="0" message="Second interval! Stay strong!"/>
      <textevent timeoffset="600" message="Final 10 minutes - dig deep!"/>
      <textevent timeoffset="1080" message="Phenomenal! 2x20 at FTP is legendary - you just proved your mental and physical strength!"/>
    </SteadyState>
    <Cooldown Duration="600" PowerLow="0.5" PowerHigh="0.4"/>
  </workout>
</workout_file>