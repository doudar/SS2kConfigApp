<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Spark Cycling</author>
  <name>Race Simulation</name>
  <description>Varied efforts mimicking race conditions</description>
  <sportType>bike</sportType>
  <tags>
  </tags>
  <workout>
    <Warmup Duration="900" PowerLow="0.5" PowerHigh="0.8"/>
    <SteadyState Duration="600" Power="0.75">
      <textevent timeoffset="0" message="Race pace tempo"/>
    </SteadyState>
    <IntervalsT Repeat="3" OnDuration="120" OffDuration="180" OnPower="1.1" OffPower="0.7">
      <textevent timeoffset="0" message="Attacks! Respond hard!"/>
    </IntervalsT>
    <SteadyState Duration="600" Power="0.85">
      <textevent timeoffset="300" message="Steady chase effort"/>
    </SteadyState>
    <IntervalsT Repeat="5" OnDuration="30" OffDuration="90" OnPower="1.5" OffPower="0.7">
      <textevent timeoffset="300" message="Final sprints - race to the line!"/>
    </IntervalsT>
    <Cooldown Duration="600" PowerLow="0.6" PowerHigh="0.4">
      <textevent timeoffset="480" message="Race-ready! You just simulated every scenario - attacks, surges, and sprints. Bring it on race day!"/>
    </Cooldown>
  </workout>
</workout_file>