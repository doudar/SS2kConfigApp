<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Spark Cycling</author>
  <name>Century Prep</name>
  <description>Long steady endurance for century training</description>
  <sportType>bike</sportType>
  <tags>
  </tags>
  <workout>
    <Warmup Duration="1200" PowerLow="0.5" PowerHigh="0.7"/>
    <SteadyState Duration="5400" Power="0.65">
      <textevent timeoffset="0" message="Settle in for a long steady effort"/>
      <textevent timeoffset="2400" message="1 hour down - stay comfortable"/>
      <textevent timeoffset="4200" message="Final hour - you&apos;re building endurance!"/>
    </SteadyState>
    <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.45">
      <textevent timeoffset="480" message="Magnificent! 2 full hours of steady riding - your century fitness is building strong!"/>
    </Cooldown>
  </workout>
</workout_file>