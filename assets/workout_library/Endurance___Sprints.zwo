<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Spark Cycling</author>
  <name>Endurance + Sprints</name>
  <description>Base miles with sprint practice</description>
  <sportType>bike</sportType>
  <tags>
  </tags>
  <workout>
    <Warmup Duration="900" PowerLow="0.5" PowerHigh="0.7"/>
    <SteadyState Duration="1200" Power="0.68"/>
    <IntervalsT Repeat="6" OnDuration="20" OffDuration="220" OnPower="1.8" OffPower="0.68">
      <textevent timeoffset="0" message="Sprint practice begins!"/>
      <textevent timeoffset="240" message="Maximum power!"/>
      <textevent timeoffset="480" message="Explosive effort!"/>
    </IntervalsT>
    <SteadyState Duration="1200" Power="0.68">
      <textevent timeoffset="1140" message="Well done! Endurance miles with explosive sprints - versatile fitness unlocked!"/>
    </SteadyState>
    <Cooldown Duration="600" PowerLow="0.65" PowerHigh="0.45"/>
  </workout>
</workout_file>