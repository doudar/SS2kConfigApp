<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Spark Cycling</author>
  <name>Micro Bursts</name>
  <description>15-second max efforts with short recovery</description>
  <sportType>bike</sportType>
  <tags>
  </tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75"/>
    <IntervalsT Repeat="20" OnDuration="15" OffDuration="45" OnPower="1.5" OffPower="0.5">
      <textevent timeoffset="0" message="20 micro bursts - go maximum!"/>
      <textevent timeoffset="300" message="Halfway through - keep it explosive!"/>
      <textevent timeoffset="600" message="Final 10 bursts!"/>
    </IntervalsT>
    <Cooldown Duration="300" PowerLow="0.6" PowerHigh="0.4">
      <textevent timeoffset="180" message="Explosive! 20 micro bursts done - your neuromuscular power is on fire!"/>
    </Cooldown>
  </workout>
</workout_file>