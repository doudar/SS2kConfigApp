<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Spark Cycling</author>
  <name>The Opener</name>
  <description>Pre-race opener workout</description>
  <sportType>bike</sportType>
  <tags>
  </tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.75">
      <textevent timeoffset="0" message="Race day opener - prime the legs"/>
    </Warmup>
    <SteadyState Duration="180" Power="0.85">
      <textevent timeoffset="0" message="Tempo effort"/>
    </SteadyState>
    <SteadyState Duration="120" Power="0.55"/>
    <IntervalsT Repeat="3" OnDuration="30" OffDuration="150" OnPower="1.3" OffPower="0.55">
      <textevent timeoffset="0" message="Sharp efforts to open up"/>
    </IntervalsT>
    <Cooldown Duration="300" PowerLow="0.6" PowerHigh="0.4">
      <textevent timeoffset="60" message="You&apos;re ready to race!"/>
    </Cooldown>
  </workout>
</workout_file>