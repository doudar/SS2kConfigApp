<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Spark Cycling</author>
  <name>Vo2 Max Builder</name>
  <description>Progressive VO2 max intervals</description>
  <sportType>bike</sportType>
  <tags>
  </tags>
  <workout>
    <Warmup Duration="900" PowerLow="0.5" PowerHigh="0.8"/>
    <IntervalsT Repeat="6" OnDuration="240" OffDuration="180" OnPower="1.12" OffPower="0.5">
      <textevent timeoffset="0" message="4-minute VO2 intervals"/>
      <textevent timeoffset="660" message="2 done, 4 to go!"/>
      <textevent timeoffset="1320" message="Halfway!"/>
      <textevent timeoffset="1980" message="Final interval!"/>
      <textevent timeoffset="2280" message="Superb! 6 x 4-minute VO2 intervals - your aerobic ceiling just got higher!"/>
    </IntervalsT>
    <Cooldown Duration="600" PowerLow="0.6" PowerHigh="0.4"/>
  </workout>
</workout_file>