<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Intervals.icu</author>
  <name>Intermittent</name>
  <description>Intermittent: This training is a way to introduce short high intensity riding alternating it with short recovery, allowing the rider to recover and accumulate time at an intensity that would be difficult to maintain if ridden consecutively.</description>
  <sportType>bike</sportType>
  <tags/>
  <workout>
    <Ramp Duration="600" PowerLow="0.39899999999999997" PowerHigh="0.73" Cadence="90">
      <textevent timeoffset="0" message="For this first interval let&apos;s aim for 10min ramp 40-73% ftp 90rpm." duration="10"/>
    </Ramp>
    <SteadyState Duration="300" Power="0.88" Cadence="90">
      <textevent timeoffset="0" message="30sec to go! Nice job with this first effort! 5min 88% ftp 90rpm." duration="10"/>
    </SteadyState>
    <SteadyState Duration="120" Power="0.529" Cadence="85">
      <textevent timeoffset="0" message="All right next up I want you to aim for 2mins at 2min 53% ftp 85rpm." duration="10"/>
    </SteadyState>
    <SteadyState Duration="120" Power="0.88" Cadence="90">
      <textevent timeoffset="0" message="2min 88% ftp 90rpm." duration="10"/>
    </SteadyState>
    <SteadyState Duration="30" Power="0.88" Cadence="105">
